{
  "permissions": {
    "allow": [
      "Bash(bash tools/*)",
      "Bash(dotnet build*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(grep *)",
      "Bash(jq *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hook-post-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Checking passive/name wiring…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/check-docs-drift.sh\"",
            "timeout": 30,
            "statusMessage": "Docs-drift check…"
          }
        ]
      }
    ]
  }
}
