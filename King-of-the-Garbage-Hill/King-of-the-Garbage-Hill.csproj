<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>King_of_the_Garbage_Hill</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net.Commands" Version="3.20.1" />
    <PackageReference Include="Discord.Net.Core" Version="3.20.1" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
    <PackageReference Include="Lamar.Microsoft.DependencyInjection" Version="16.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Battleship\**\*.cs" />
    <Compile Remove="Clash\**\*.cs" />
    <ProjectReference Include="Battleship\King-of-the-Garbage-Hill.Games.Battleship.csproj" />
    <ProjectReference Include="Clash\King-of-the-Garbage-Hill.Games.Clash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <!-- Copy wwwroot (Vue production build) to output directory -->
  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" LinkBase="wwwroot" />
  </ItemGroup>

  <!-- Copy DataBase JSON files to output directory -->
  <ItemGroup>
    <None Include="DataBase\blackjack_words.json" CopyToOutputDirectory="PreserveNewest" LinkBase="DataBase" />
    <None Include="DataBase\localization.en.json" CopyToOutputDirectory="PreserveNewest" LinkBase="DataBase" />
    <None Include="DataBase\phrases.en.json" CopyToOutputDirectory="PreserveNewest" LinkBase="DataBase" />
    <None Include="..\Localization\*.messages.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Localization" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
